<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>7.3</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.6" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.6">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <!--
      The plugin compiles against host-provided SDK assemblies and excludes
      their runtime assets. The tests have no XrmToolBox host, so they bring
      their own copy in order to exercise the SDK-to-model mapping — the one
      layer that cannot be checked without a live environment otherwise.
      Pinned to the version the plugin resolves.
    -->
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="9.0.2.59" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DataverseErdVisualizer.csproj" />
  </ItemGroup>

</Project>
